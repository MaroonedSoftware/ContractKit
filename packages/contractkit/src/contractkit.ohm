// =====================================================================
// Contract DSL Grammar — Source of Truth
// Ohm PEG Grammar (https://ohmjs.org/)
//
// Single unified grammar for .ck files containing contracts (type
// declarations) and operations (route/endpoint declarations).
//
// Convention: PascalCase = syntactic rules (auto-skip whitespace)
//             camelCase  = lexical rules (no whitespace skipping)
//
// IMPORTANT: Keywords used in syntactic rules MUST be defined as
// lexical (camelCase) rules with ~identPart guards. Ohm auto-skips
// whitespace between items in syntactic rules, which means an inline
// "keyword" ~identPart would check ~identPart against the NEXT TOKEN
// (after skipping space), not the character immediately after the keyword.
// =====================================================================

Contract {

  // ─── Top-level ──────────────────────────────────────────────────

  Root = OptionsBlock? Decl* end

  Decl = RouteDecl
       | ModelDecl

  // ─── Options block ──────────────────────────────────────────────
  // Structured metadata with named sections.

  // The leading `comment*` belongs here rather than on Root: if it sat on Root, its greedy match
  // would swallow the doc comment above a `contract`/`operation` in a file that has no options
  // block at all. Failing inside OptionsBlock backtracks the comments too.
  OptionsBlock = comment* optionsKw "{" OptionsBodyItem* "}"

  OptionsBodyItem = comment
                  | OptionsKeysBlock
                  | OptionsServicesBlock
                  | OptionsRequestBlock
                  | OptionsResponseBlock
                  | SecurityBlock

  OptionsRequestBlock  = requestKw  ":" "{" (comment | OptionsHeadersBlock)* "}"
  OptionsResponseBlock = responseKw ":" "{" (comment | OptionsHeadersBlock)* "}"

  OptionsHeadersBlock = headersKw ":" "{" (comment | ResponseHeaderField)* "}"

  OptionsKeysBlock = keysKw ":" "{" (comment | OptionsEntry)* "}"

  OptionsServicesBlock = servicesKw ":" "{" (comment | OptionsEntry)* "}"

  OptionsEntry = identifier ":" optionsEntryValue

  // Lexical, so the optional trailing comment can only be one on the *same line*. As a syntactic
  // rule it would skip newlines and claim the standalone comment on the line below instead.
  optionsEntryValue = optionsValue optionsInlineComment?

  optionsInlineComment = (" " | "\t")+ comment

  optionsValue = stringLit             -- quoted
               | optionsRawValue       -- unquoted

  optionsRawValue = optionsRawChar+

  // Stops before whitespace-then-"#" so a trailing comment stays a comment. Previously the comment
  // was swallowed into the value, and any "}" inside it — `# see {{area}}` — closed the block early
  // and silently mis-parsed the rest of the file. A bare "#" still belongs to the value, because an
  // unquoted Node subpath import (`#modules/pet/pet.service.js`) is the idiomatic `services` value.
  optionsRawChar = ~("\n" | "\r" | "}" | " #" | "\t#") any

  // ─── Models ─────────────────────────────────────────────────────

  ModelDecl = comment* contractKw ModelPrefix ":" ModelBody

  ModelPrefix = modelModifier* identifier

  modelModifier = objectMode | formatMode | deprecatedKw

  ModelBody = identifier ("&" identifier)* "&" "{" FieldList "}"  -- inheritance
            | "{" FieldList "}"                                    -- fields
            | TypeExpression comment?                              -- alias

  // ─── Fields ─────────────────────────────────────────────────────

  FieldList = (comment | FieldEntry)*

  FieldEntry = FieldDecl ","?

  FieldDecl = identifier "?"? ":" FieldBody

  FieldBody = fieldModifier* TypeExpression ("=" DefaultValue)?

  fieldModifier = "readonly"  ~identPart   -- readonly
                | "writeonly" ~identPart   -- writeonly
                | deprecatedKw             -- deprecated
                | overrideKw               -- override

  // ─── Type Expressions ───────────────────────────────────────────

  TypeExpression = "|"? IntersectionExpr ("|" IntersectionExpr)*

  IntersectionExpr = SingleType ("&" SingleType)*

  SingleType = objectMode InlineBraceObject                   -- modedObject
             | InlineBraceObject                               -- bareObject
             | identifier "(" TypeArgs ")"                     -- withArgs
             | identifier                                      -- simple

  // ─── Type Arguments & Constraints ───────────────────────────────

  TypeArgs = ListOf<TypeArg, ",">

  TypeArg = identifier "=" ArgValue   -- keyValue
          | stringLit                 -- string
          | numberLit                 -- number
          | booleanLit                -- boolean
          | TypeExpression            -- type

  ArgValue = regexLiteral   -- regex
           | numberLit      -- number
           | stringLit      -- string
           | booleanLit     -- boolean
           | identifier     -- ident

  regexLiteral = "/" regexChar* "/"

  regexChar = ~("/" | "\n") any

  // ─── Inline Brace Objects ───────────────────────────────────────

  InlineBraceObject = "{" InlineFieldList "}"

  InlineFieldList = (comment | InlineFieldEntry)*

  InlineFieldEntry = InlineField ","?

  InlineField = identifier "?"? ":" FieldBody

  // ─── Default Values ─────────────────────────────────────────────

  DefaultValue = stringLit
               | numberLit
               | booleanLit
               | identifier

  // ─── Object/Parse Modes ─────────────────────────────────────────

  objectMode = modeKw "(" modeOption ")"

  modeOption = "strict" | "strip" | "loose"

  formatMode = formatKw "(" space* formatArg (space* "," space* formatArg)* space* ")"
  formatArg = ("input" | "output") "=" caseOption

  caseOption = "camel" | "snake" | "pascal"

  // ─── Routes ─────────────────────────────────────────────────────

  RouteDecl = comment* operationKwCall RoutePath ":" "{" RouteBody "}"

  operationKwCall = operationKw "(" routeModifier ")"  -- modified
                  | operationKw                         -- plain

  RoutePath = PathSegment+

  PathSegment = "/" "{" identifier "}"   -- param
              | "/" identifier            -- literal

  RouteBody = RouteBodyItem*

  RouteBodyItem = comment
                | ParamsBlock
                | SecurityBlock
                | HttpOperation

  // ─── Path Parameters ────────────────────────────────────────────

  ParamsBlock = objectMode? paramsKw ":" ParamsBody

  ParamsBody = "{" (comment | ParamDecl)* "}"   -- inline
             | identifier                        -- ref

  ParamDecl = identifier ":" TypeExpression comment?

  // ─── HTTP Operations ────────────────────────────────────────────

  httpMethod = ("get" | "post" | "put" | "patch" | "delete") ~identPart

  routeModifier = ("internal" | "deprecated" | "public") ~identPart

  httpMethodCall = httpMethod "(" routeModifier ")"  -- modified
                 | httpMethod                         -- plain

  HttpOperation = comment* httpMethodCall ":" "{" comment? OperationBody "}"

  OperationBody = OperationBodyItem*

  OperationBodyItem = comment
                    | NameDecl
                    | ServiceDecl
                    | SdkDecl
                    | McpDecl
                    | SignatureDecl
                    | QueryBlock
                    | HeadersBlock
                    | RequestBlock
                    | ResponseBlock
                    | SecurityBlock
                    | PluginsDecl

  // ─── Service & SDK ──────────────────────────────────────────────

  NameDecl = nameKw ":" nameText
  nameText = (~("\n" | "#" | "}") any)+

  ServiceDecl = serviceKw ":" identifier

  SdkDecl = sdkKw ":" identifier

  // ─── MCP ────────────────────────────────────────────────────────
  // `mcp: true|false` or a settings block. Text fields are quoted strings;
  // `hint` is a bracket-less comma-separated token list (enum-style). The two
  // McpFieldValue forms are unambiguous: a string starts with a quote, a hint
  // list starts with an identifier. The comma-terminated list stops at the line
  // boundary because the next field has no leading comma.
  McpDecl = mcpKw ":" booleanLit                     -- bool
          | mcpKw ":" "{" (comment | McpField)* "}"  -- block

  McpField = identifier ":" McpFieldValue comment?

  McpFieldValue = stringLit                        -- string
                | NonemptyListOf<identifier, ",">  -- hintList

  SignatureDecl = signatureKw ":" SignatureBlock               -- block
                | signatureKw ":" (stringLit | identifier)     -- bare

  SignatureBlock = "{" (comment | SignatureField)* "}"

  SignatureField = SignatureOptionsLine
                 | SignaturePolicyLine

  SignatureOptionsLine = optionsKw ":" (stringLit | identifier) comment?
  SignaturePolicyLine  = policyKw ":" identifier comment?

  // ─── Query & Headers ────────────────────────────────────────────

  QueryBlock = objectMode? queryKw ":" TypeExpression

  HeadersBlock = headersKw ":" noneKw                  -- none
               | objectMode? headersKw ":" TypeExpression  -- type

  // ─── Request & Response ─────────────────────────────────────────

  RequestBlock = requestKw ":" "{" (comment | ContentTypeLine)* "}"

  ResponseBlock = responseKw ":" "{" (comment | StatusCodeBlock)* "}"

  StatusCodeBlock = statusCodeCall ":" ("{" StatusCodeBodyItem* "}")?

  // Lexical throughout, mirroring httpMethodCall, so `404 (documented)` is rejected the same way
  // `get (internal)` is. A syntactic rule would skip whitespace between the code and the paren —
  // whitespace the TextMate grammar and the printer both assume is absent.
  statusCodeCall = numberLit statusModifiers  -- modified
                 | numberLit                  -- plain

  statusModifiers = "(" statusModifier ("," " "* statusModifier)* ")"

  statusModifier = "documented" ~identPart

  StatusCodeBodyItem = comment
                     | ResponseHeadersBlock
                     | ContentTypeLine

  ContentTypeLine = mimeType ":" TypeExpression

  mimeType = mimeChar+ "/" mimeChar+

  mimeChar = alnum | "-" | "." | "+" | "_"

  ResponseHeadersBlock = headersKw ":" noneKw                                    -- none
                       | headersKw ":" "{" (comment | ResponseHeaderField)* "}"  -- fields

  ResponseHeaderField = identifier "?"? ":" TypeExpression comment?

  // ─── Plugins ────────────────────────────────────────────────────

  PluginsDecl = pluginsKw ":" "{" (comment | PluginEntry)* "}"
  PluginEntry  = identifier ":" PluginValue

  PluginValue = stringLit                                  -- string
              | numberLit                                  -- number
              | booleanLit                                 -- boolean
              | nullKw                                     -- null
              | "{" (comment | PluginField)* "}"           -- object
              | "[" (comment | PluginValue)* "]"           -- array

  PluginField = (identifier | stringLit) ":" PluginValue

  // ─── Security ───────────────────────────────────────────────────

  SecurityBlock = securityKw ":" SecurityBody

  SecurityBody = noneKw                                             -- none
               | "{" (comment | SecurityField)* "}"                 -- fields

  SecurityField = SecurityPolicyLine
                | SecuritySignatureLine

  SecurityPolicyLine = policyKw ":" PolicyValue comment?

  PolicyValue = noneKw     -- none
              | identifier -- name

  SecuritySignatureLine = signatureKw ":" (stringLit | identifier) comment?

  // ─── Keywords (lexical to avoid whitespace-skipping issues) ─────

  modeKw = "mode" ~identPart
  formatKw = "format" ~identPart
  contractKw = "contract" ~identPart
  optionsKw = "options" ~identPart
  keysKw = "keys" ~identPart
  servicesKw = "services" ~identPart
  operationKw = "operation" ~identPart
  paramsKw = "params" ~identPart
  serviceKw = "service" ~identPart
  nameKw = "name" ~identPart
  sdkKw = "sdk" ~identPart
  mcpKw = "mcp" ~identPart
  signatureKw = "signature" ~identPart
  queryKw = "query" ~identPart
  headersKw = "headers" ~identPart
  requestKw = "request" ~identPart
  responseKw = "response" ~identPart
  securityKw = "security" ~identPart
  pluginsKw = "plugins" ~identPart
  noneKw = "none" ~identPart
  nullKw = "null" ~identPart
  policyKw = "policy" ~identPart
  deprecatedKw = "deprecated" ~identPart
  overrideKw = "override" ~identPart

  // ─── Lexical Rules ──────────────────────────────────────────────

  comment = "#" (~"\n" any)* ("\n" | end)

  identifier = identStart identPart*

  identStart = letter | "_" | "$"

  identPart = alnum | "_" | "$" | "-" | "."

  stringLit = "\"" doubleStringChar* "\""
            | "'" singleStringChar* "'"

  doubleStringChar = ~("\"" | "\n") any

  singleStringChar = ~("'" | "\n") any

  numberLit = "-"? digit+ ("." digit+)?

  booleanLit = "true" ~identPart
             | "false" ~identPart

  // Override space to skip whitespace and newlines but NOT comments
  space += "\n" | "\r"
}
